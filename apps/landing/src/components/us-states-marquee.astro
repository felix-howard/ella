---
/**
 * Infinite horizontal marquee of US states (with state flags) served by Ella.
 * The track renders the state list twice so translateX(-50%) loops seamlessly;
 * the duplicate set is aria-hidden to avoid screen-reader repetition.
 */
import { usStates } from "@/config/us-states";

interface Props {
  eyebrow?: string;
  title?: string;
}

const {
  eyebrow = "Nationwide coverage",
  title = "Federal and state tax support across all 50 states",
} = Astro.props;
---

<section class="border-b border-neutral-border bg-surface-muted py-10 sm:py-12" aria-labelledby="states-marquee-title">
  <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
    <p class="text-sm font-semibold uppercase tracking-widest text-primary-700">{eyebrow}</p>
    <h2 id="states-marquee-title" class="mt-2 text-xl font-bold text-slate-950 sm:text-2xl font-heading">
      {title}
    </h2>
  </div>

  <div class="states-marquee mt-8" role="group" aria-label="US states served by Ella Tax Services">
    <ul class="states-marquee__track">
      {usStates.map((state) => (
        <li class="states-chip">
          <img
            src={`/assets/state-flags/us-${state.code}.png`}
            alt={`${state.name} state flag`}
            width="28"
            height="28"
            loading="lazy"
            decoding="async"
            class="states-chip__flag"
          />
          <span class="states-chip__label">{state.name}</span>
        </li>
      ))}
      {usStates.map((state) => (
        <li class="states-chip" aria-hidden="true">
          <img
            src={`/assets/state-flags/us-${state.code}.png`}
            alt=""
            width="28"
            height="28"
            loading="lazy"
            decoding="async"
            class="states-chip__flag"
          />
          <span class="states-chip__label">{state.name}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .states-marquee {
    position: relative;
    overflow: hidden;
    /* Fade the left/right edges so chips slide in and out smoothly. */
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 8%,
      #000 92%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 8%,
      #000 92%,
      transparent 100%
    );
  }

  .states-marquee__track {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: max-content;
    padding: 0.25rem 0.375rem;
    animation: states-marquee-scroll 70s linear infinite;
  }

  /* Pause the loop while the visitor hovers, so they can read a state. */
  .states-marquee:hover .states-marquee__track {
    animation-play-state: paused;
  }

  .states-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex: none;
    padding: 0.4375rem 0.875rem 0.4375rem 0.4375rem;
    border-radius: 9999px;
    border: 1px solid var(--color-neutral-border);
    background: var(--color-neutral-card);
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.04);
  }

  .states-chip__flag {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 9999px;
    object-fit: cover;
    background: var(--color-neutral-muted);
    box-shadow: inset 0 0 0 1px rgb(15 23 42 / 0.06);
  }

  .states-chip__label {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    color: var(--color-neutral-text-secondary);
  }

  @keyframes states-marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      /* Half the track = exactly one full state set, so the loop is seamless. */
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .states-marquee__track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      width: auto;
    }
    .states-marquee {
      -webkit-mask-image: none;
      mask-image: none;
    }
    /* Static view: drop the duplicate set so each state shows once. */
    .states-chip[aria-hidden="true"] {
      display: none;
    }
  }
</style>
